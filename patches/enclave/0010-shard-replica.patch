+LoopbackServer::Entities LoopbackServer::ExportEntities() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  Entities result;
+  result.reserve(entities_.size());
+  for (const auto& [id, entity] : entities_) {
+    entity->SerializeAsLoopbackServerEntity(&result.emplace_back());
+  }
+  return result;
+}
+
+std::vector<int> LoopbackServer::ImportEntities(Entities entities) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  DataTypeSet changed;
+  for (const sync_pb::LoopbackServerEntity& proto : entities) {
+    std::unique_ptr<LoopbackServerEntity> entity =
+        LoopbackServerEntity::CreateEntityFromProto(proto);
+    if (!entity || entity->GetId() != proto.entity().id_string() ||
+        !IsRealDataType(entity->GetDataType())) {
+      continue;
+    }
+    // A new version makes the client fetch it at its next GetUpdates.
+    UpdateEntityVersion(entity.get());
+    changed.Put(entity->GetDataType());
+    entities_[entity->GetId()] = std::move(entity);
+  }
+  if (!changed.empty()) {
+    ScheduleSaveStateToFile();
+  }
+  std::vector<int> field_numbers;
+  for (DataType type : changed) {
+    field_numbers.push_back(GetSpecificsFieldNumberFromDataType(type));
+  }
+  return field_numbers;
+}
+
+void LoopbackServer::ResetWithKeystoreKey(std::vector<uint8_t> keystore_key) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  ClearServerData();
+  keystore_keys_.clear();
+  keystore_keys_.push_back(std::move(keystore_key));
+  ScheduleSaveStateToFile();
+}
+
+std::vector<std::vector<uint8_t>> LoopbackServer::GetKeystoreKeys() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  return keystore_keys_;
+}
