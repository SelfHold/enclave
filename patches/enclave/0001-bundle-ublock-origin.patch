+void ComponentLoader::AddEnclaveUblock() {
+#if BUILDFLAG(IS_ANDROID)
+  std::optional<base::DictValue> manifest =
+      ParseManifest(enclave::UblockManifest());
+  const std::string* version =
+      manifest ? manifest->FindString("version") : nullptr;
+  if (!version) {
+    return;
+  }
+  std::string version_copy = *version;
+  GetExtensionFileTaskRunner()->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(&enclave::EnsureUblockExtracted, std::move(version_copy)),
+      base::BindOnce(&ComponentLoader::OnEnclaveUblockExtracted,
+                     weak_factory_.GetWeakPtr(), std::move(*manifest)));
+#else
+  Add(enclave::UblockManifest(),
+      base::FilePath::FromASCII(enclave::kUblockDirName),
+      /*skip_allowlist=*/true);
+#endif  // BUILDFLAG(IS_ANDROID)
+}
+
+#if BUILDFLAG(IS_ANDROID)
+void ComponentLoader::OnEnclaveUblockExtracted(base::DictValue manifest,
+                                             const base::FilePath& directory) {
+  if (!directory.empty()) {
+    Add(std::move(manifest), directory, /*skip_allowlist=*/true);
+  }
+}
+#endif  // BUILDFLAG(IS_ANDROID)
