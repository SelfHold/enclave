# Enclave: the Connector API over Shard's bound service (CONNECTOR.md § 3.2).
#
#   :connector_aidl  the two AIDL files, byte-for-byte copies from Shard
#   :jni             JNI glue for ShardConnectorBridge.java
#   :java            the bridge; listed in chrome_java's deps
#   :android         the C++ side; a dep of //chrome/browser/enclave/shard

import("//build/config/android/rules.gni")
import("//third_party/jni_zero/jni_zero.gni")

_bridge_java = "java/src/org/chromium/chrome/browser/enclave/shard/ShardConnectorBridge.java"

android_aidl("connector_aidl") {
  # IShardConnector.aidl imports IConnectorWatcher from the same package.
  import_include = [ "java/src/" ]
  sources = [
    "java/src/dev/selfhold/shard/connector/IConnectorWatcher.aidl",
    "java/src/dev/selfhold/shard/connector/IShardConnector.aidl",
  ]
}

generate_jni("jni") {
  sources = [ _bridge_java ]
}

android_library("java") {
  sources = [ _bridge_java ]
  srcjar_deps = [
    ":connector_aidl",
    ":jni",
  ]
  deps = [
    "//base:base_java",
    "//build/android:build_java",
    "//third_party/jni_zero:gendeps_java",
    "//third_party/jni_zero:jni_zero_java",
  ]
}

source_set("android") {
  sources = [
    "android_connector_transport.cc",
    "android_connector_transport.h",
  ]
  public_deps = [ "//components/enclave_shard" ]
  deps = [
    ":jni",
    "//base",
    "//components/enclave_shard:connector_proto",
    "//third_party/jni_zero",
  ]
}
