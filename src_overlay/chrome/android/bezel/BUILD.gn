# Bezel: uBlock Origin packaged into the APK. bezel_ublock.zip is generated by
# `bezel.py apply` from vendor/ublock.

import("//build/config/android/rules.gni")

android_assets("bezel_ublock_assets") {
  sources = [ "bezel_ublock.zip" ]

  # Stored uncompressed so that native code can read it as a byte range.
  disable_compression = true
}
